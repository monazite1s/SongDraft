# 复制为 .env.local（本地）或 .env.production（服务器），切勿提交真实密钥。

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# 对外访问地址（影响分享链接语义与 cookie Secure 推断）
# 纯 HTTP 公网 IP 示例：http://1.2.3.4
# 正式 HTTPS：https://your-domain.example
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# 纯 HTTP 部署务必 false 或依赖 Nginx 的 X-Forwarded-Proto: http
# 上 HTTPS 后改为 true
COOKIE_SECURE=false

# 反代场景下 Origin/Host 不一致时，填公网 IP 或域名（不含协议，逗号分隔）
# SERVER_ACTION_ORIGINS=1.2.3.4,your-domain.example

# 自写 Auth（生产必填）
DATABASE_URL=postgresql://songdraft:songdraft@127.0.0.1:5432/songdraft
AUTH_SESSION_SECRET=replace-with-openssl-rand-base64-48

# 存储：正式用 cos；本地可省略或 mock
STORAGE_DRIVER=cos
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=ap-guangzhou

# AI
TEXT_PROVIDER_MODE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

MUSIC_PROVIDER_MODE=minimax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MUSIC_MODEL=music-2.6

ZHIPU_API_KEY=
GLM_VISION_MODEL=glm-4v-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
