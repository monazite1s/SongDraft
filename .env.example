# Supabase Auth (client-safe values only have NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL business database
DATABASE_URL=postgresql://songdraft:songdraft@localhost:5432/songdraft

# Object storage. Use mock for local development without Tencent COS credentials.
STORAGE_DRIVER=mock
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=
TENCENT_COS_PUBLIC_BASE_URL=

# Mock is the transparent default for the Hackathon demo.
MUSIC_PROVIDER_MODE=mock
PROVIDER_SECRET_ENCRYPTION_KEY=
